# Bharat Gas WhatsApp Message Sender - backend environment
# Copy to .env and fill in your own values. Never commit real credentials.

# PostgreSQL connection string for the application database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/whatsapp_sender

# WhatsApp delivery mode: "dry" simulates sends without contacting Meta; "live"
# sends real messages.
#
# IMPORTANT: "live" FAILS CLOSED. If WHATSAPP_PHONE_NUMBER_ID or
# WHATSAPP_ACCESS_TOKEN is missing, every send is rejected with a configuration
# error and no request is made to Meta — it never silently falls back to
# simulating, because a fake success looks identical to a real delivery.
# A misconfiguration is logged at startup and shown in the UI as NOT CONFIGURED.
WHATSAPP_MODE=dry

# Meta WhatsApp Cloud API credentials (only required for real sends).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Webhook delivery callbacks. Register the public URL of this backend with
# {WHATSAPP_MODE=live} as, e.g. https://api.example.com/webhooks/whatsapp
#
# WHATSAPP_WEBHOOK_VERIFY_TOKEN: any random string you choose. Meta sends it
# once during the subscription handshake (GET) and we must echo the challenge.
# Use a long random value; treat it like a credential.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
#
# WHATSAPP_APP_SECRET: the App Secret from the Meta App dashboard (Settings >
# Basic). Used to verify the X-Hub-Signature-256 HMAC on every delivery POST.
# In "live" mode or NODE_ENV=production this is REQUIRED and webhook delivery
# updates are rejected without it. It is left unset in "dry" mode only so the
# feature can be exercised locally without a real Meta app.
WHATSAPP_APP_SECRET=

# Meta Graph API version used for the WhatsApp Cloud API.
WHATSAPP_API_VERSION=v21.0

# Default country code used to expand local 10-digit numbers to E.164.
WHATSAPP_COUNTRY_CODE=91

# Default template language when a template does not specify one.
WHATSAPP_TEMPLATE_LANGUAGE=en

# Comma-separated list of allowed browser origins for CORS (e.g. http://localhost:3000).
# Use * to allow any origin (not recommended).
ALLOWED_ORIGINS=http://localhost:3000

# Basic rate limiting (requests per window per IP).
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# HTTP port. Defaults to 3001; set it to whatever your host injects
# (Heroku, Render, Cloud Run, ECS and Kubernetes all provide PORT).
PORT=3001

# Maximum accepted request body size. Must be comfortably larger than a
# batched Meta delivery notification: express's implicit default of 100kb is
# not, and a rejected batch (413) is retried by Meta forever, so its delivery
# statuses are never recorded.
BODY_LIMIT=1mb

# ---------------------------------------------------------------------------
# AI Assistant — OPTIONAL. The application boots and runs normally with this
# whole section empty; the AI page then shows a clean configuration error
# ("AI provider is not configured") instead of failing.
#
# SAFETY: AI output is ALWAYS a draft. A human must review and edit it before
# use, and the AI endpoints can never send a WhatsApp message themselves.
#
# SECURITY: these keys are read from the environment ONLY. They are never
# written to the database (AppSetting), never returned in any API response, and
# never sent to the browser. The frontend only ever talks to our own backend.
# ---------------------------------------------------------------------------
# Provider: "openai" or "deepseek"; used when a request does not pick one.
AI_PROVIDER=openai

# OpenAI credentials (only needed when AI_PROVIDER=openai or a request asks for openai).
OPENAI_API_KEY=
# Keep model names configurable; defaults change over time.
OPENAI_MODEL=gpt-4o-mini

# DeepSeek credentials (only needed when AI_PROVIDER=deepseek or a request asks for deepseek).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Reasonable per-request timeout (ms) for AI provider calls. A request that
# exceeds this returns a clean 504 error to the operator.
AI_TIMEOUT_MS=30000

# ---- Admin authentication (API access control) ----
# Single-operator admin login. Placeholders only - never commit real values.
# ADMIN_USERNAME: admin identifier used with the login form.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH: scrypt hash of the admin password. Generate one with:
#   npm run hash:password -- <your-password>
# (do NOT store a plaintext password here)
ADMIN_PASSWORD_HASH=
# AUTH_SECRET: long random value used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# AUTH_SESSION_HOURS: session cookie lifetime in hours (default 168 = 7 days).
AUTH_SESSION_HOURS=168
# AUTH_COOKIE_SECURE: set true to send the session cookie with Secure (HTTPS only).
# Defaults to true when NODE_ENV=production; leave false for local http development.
AUTH_COOKIE_SECURE=false